# ──────────────────────────────────────────────────────────────────────────
# Tribune monorepo — environment template
# Copy to .env (gitignored) and fill the blanks. Values shown are the defaults
# that match the Joi schemas in apps/api and apps/panel; uncomment Phase 4
# rows after deploying contracts.
# ──────────────────────────────────────────────────────────────────────────

# Node runtime (defaults to "development" via Joi if unset).
# NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tribune:tribune@localhost:5432/tribune

# ── Ports ───────────────────────────────────────────────────────────────
API_PORT=3001
PANEL_PORT=3002
WEB_PORT=3000

# ── Web → API ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=Mock panel

# ── 0G Chain (Galileo testnet) ─────────────────────────────────────────
NEXT_PUBLIC_OG_CHAIN_ID=16601
NEXT_PUBLIC_OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# ── WalletConnect / RainbowKit (Phase 4 onchain UI) ────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── API: CORS / logging / runtime ──────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Panel ↔ API ────────────────────────────────────────────────────────
APP_PROFILE=demo                       # test | demo | replay | local
PANEL_SERVICE_URL=http://localhost:3002
TRIBUNE_API_URL=http://localhost:3001
TRIBUNE_PANEL_SHARED_SECRET=dev-only-change-me
PANEL_FIXTURES_DIR=./fixtures

# Required only when APP_PROFILE=local or when recording new replay fixtures.
# A 0x-prefixed 32-byte hex private key for a funded 0G testnet account.
PANEL_PRIVATE_KEY=

# ── Phase 4 contracts (uncomment after running packages/contracts/script/Deploy.s.sol) ──
# CHAIN_ID=16601
# EXPLORER_BASE_URL=https://chainscan-galileo.0g.ai
# ARBITRATOR_ADDRESS=
# PANEL_REGISTRY_ADDRESS=
# EXAMPLE_ESCROW_ADDRESS=
# SETTLEMENT_TOKEN_ADDRESS=
# ARBITRATOR_START_BLOCK=0

# ── Phase 4 KeeperHub MCP (gated execution) ────────────────────────────
# Sign up at https://docs.keeperhub.com/, then point the panel here.
# KEEPERHUB_MCP_URL=
# KEEPERHUB_API_KEY=

# ── Phase 4 Uniswap (cross-token settlement leg) ───────────────────────
# UNISWAP_ROUTER_ADDRESS=

# ── Phase 4 ENS (reputation text-record writes) ────────────────────────
# ENS_PUBLIC_RESOLVER_ADDRESS=
# ENS_REGISTRY_ADDRESS=
# ENS_SUBNAME_SPACE=tribune.eth
