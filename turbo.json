{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "API_PORT",
    "WEB_PORT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_OG_CHAIN_ID",
    "NEXT_PUBLIC_OG_RPC_URL",
    "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
    "NEXT_PUBLIC_DEMO_MODE",
    "WEB_ORIGIN",
    "LOG_LEVEL",
    "APP_PROFILE",
    "PANEL_PORT",
    "PANEL_SERVICE_URL",
    "TRIBUNE_API_URL",
    "TRIBUNE_PANEL_SHARED_SECRET",
    "OG_RPC_URL",
    "OG_STORAGE_INDEXER_URL",
    "PANEL_PRIVATE_KEY",
    "PANEL_FIXTURES_DIR",
    "ARBITRATOR_ADDRESS",
    "PANEL_REGISTRY_ADDRESS",
    "EXAMPLE_ESCROW_ADDRESS",
    "SETTLEMENT_TOKEN_ADDRESS",
    "ARBITRATOR_START_BLOCK",
    "CHAIN_ID",
    "EXPLORER_BASE_URL",
    "KEEPERHUB_MCP_URL",
    "KEEPERHUB_API_KEY",
    "UNISWAP_ROUTER_ADDRESS",
    "ENS_PUBLIC_RESOLVER_ADDRESS",
    "ENS_REGISTRY_ADDRESS",
    "ENS_SUBNAME_SPACE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "^db:generate"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "cache": true,
      "outputs": ["node_modules/.prisma/**", "node_modules/@prisma/client/**"],
      "inputs": ["prisma/schema.prisma"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": false,
      "interactive": true
    },
    "clean": {
      "cache": false
    }
  }
}
