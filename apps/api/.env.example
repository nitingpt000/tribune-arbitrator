# ──────────────────────────────────────────────────────────────────────────
# apps/api — environment template (mirrors apps/api/src/common/config.schema.ts)
# Copy to apps/api/.env (gitignored) for local dev; the root .env.example is
# the canonical "copy this for the whole monorepo" file.
# ──────────────────────────────────────────────────────────────────────────

# Postgres
DATABASE_URL=postgresql://tribune:tribune@localhost:5432/tribune

# Runtime
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Profile + panel wiring
APP_PROFILE=demo                       # test | demo | replay | local
PANEL_SERVICE_URL=http://localhost:3002
TRIBUNE_PANEL_SHARED_SECRET=dev-only-change-me

# ── Phase 4 contracts (uncomment after deploy) ─────────────────────────
# CHAIN_ID=16601
# EXPLORER_BASE_URL=https://chainscan-galileo.0g.ai
# ARBITRATOR_ADDRESS=
# PANEL_REGISTRY_ADDRESS=
# EXAMPLE_ESCROW_ADDRESS=
# SETTLEMENT_TOKEN_ADDRESS=
