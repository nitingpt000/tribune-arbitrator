# ──────────────────────────────────────────────────────────────────────────
# apps/web — environment template
# Copy to apps/web/.env.local (gitignored) for local dev. Only NEXT_PUBLIC_*
# variables are read at the browser; everything else lives in the API or
# panel templates.
# ──────────────────────────────────────────────────────────────────────────

# Where the Next.js app calls the API (used by TribuneClient and useInfo()).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Demo-mode pill fallback when /info isn't reachable. The header normally
# overrides this with the live label from /info.
NEXT_PUBLIC_DEMO_MODE=Mock panel

# WalletConnect project id — required only when wagmi/RainbowKit are wired
# back into the file-dispute path (Phase 4 follow-up).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# 0G Chain identifiers used by client-side wagmi config (Phase 4 onchain UI).
NEXT_PUBLIC_OG_CHAIN_ID=16601
NEXT_PUBLIC_OG_RPC_URL=https://evmrpc-testnet.0g.ai
