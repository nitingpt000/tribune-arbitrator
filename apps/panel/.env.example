# Panel app — copy to apps/panel/.env to run.
APP_PROFILE=test                       # test | local | demo | replay
PANEL_PORT=3002

# apps/api callback origin (panel calls back to apps/api with vote / verdict / settlement events)
TRIBUNE_API_URL=http://localhost:3001
TRIBUNE_PANEL_SHARED_SECRET=dev-only-change-me

# 0G testnet — only required when APP_PROFILE=local or replay (recording)
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
PANEL_PRIVATE_KEY=

# Misc
LOG_LEVEL=info
PANEL_FIXTURES_DIR=./fixtures
