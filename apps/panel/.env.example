# ──────────────────────────────────────────────────────────────────────────
# apps/panel — environment template
# Mirrors apps/panel/src/infrastructure/config/config.schema.ts. Copy to
# apps/panel/.env (gitignored) for local dev.
# ──────────────────────────────────────────────────────────────────────────

APP_PROFILE=demo                       # test | demo | replay | local
PANEL_PORT=3002

# apps/api callback origin (panel posts vote / verdict / settlement events back)
TRIBUNE_API_URL=http://localhost:3001
TRIBUNE_PANEL_SHARED_SECRET=dev-only-change-me

# 0G testnet — required when APP_PROFILE=local, or when recording fixtures
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
PANEL_PRIVATE_KEY=

# Misc
LOG_LEVEL=info
PANEL_FIXTURES_DIR=./fixtures

# ── Phase 4 contracts (uncomment after deploy) ─────────────────────────
# CHAIN_ID=16601
# ARBITRATOR_ADDRESS=
# EXAMPLE_ESCROW_ADDRESS=
# ARBITRATOR_START_BLOCK=0

# ── Phase 4 KeeperHub MCP (sets execution to onchain via guaranteed-keeper) ──
# When KEEPERHUB_MCP_URL + KEEPERHUB_API_KEY + ARBITRATOR_ADDRESS are all set,
# the panel switches from DirectTxAdapter to OnchainKeeperExecutionAdapter.
# KEEPERHUB_MCP_URL=
# KEEPERHUB_API_KEY=

# ── Phase 4 Uniswap (cross-token settlement leg) ───────────────────────
# UNISWAP_ROUTER_ADDRESS=

# ── Phase 4 ENS (reputation text-record writes) ────────────────────────
# When ENS_PUBLIC_RESOLVER_ADDRESS + PANEL_PRIVATE_KEY are set, the panel
# switches from ReadonlyEnsAdapter to EnsReputationIdentityAdapter.
# ENS_PUBLIC_RESOLVER_ADDRESS=
# ENS_REGISTRY_ADDRESS=
ENS_SUBNAME_SPACE=tribune.eth
